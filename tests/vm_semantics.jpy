// JapyScript — VM semantics conformance test
//
// Exercises every opcode path the reference VM implements. Must pass on
// every compiler / VM version.

// --------------------------------------------------------------------------
// Arithmetic
// --------------------------------------------------------------------------

assert 1 + 2 == 3
assert 10 - 4 == 6
assert 3 * 4 == 12
assert 10 / 2 == 5
assert 10 % 3 == 1
assert 2 ** 10 == 1024

// --------------------------------------------------------------------------
// Comparison and logic
// --------------------------------------------------------------------------

assert 1 < 2
assert 2 <= 2
assert 3 > 2
assert 3 >= 3
assert 1 != 2
assert "abc" == "abc"

assert true && true
assert !false
assert (true || false)

// --------------------------------------------------------------------------
// Variables and scoping
// --------------------------------------------------------------------------

x = 10
let y = 20
const Z = 30
var w = 40

assert x + y + Z + w == 100

// --------------------------------------------------------------------------
// Conditionals
// --------------------------------------------------------------------------

def classify(n):
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    else:
        return "positive"

assert classify(-5) == "negative"
assert classify(0) == "zero"
assert classify(7) == "positive"

// --------------------------------------------------------------------------
// Loops
// --------------------------------------------------------------------------

sum = 0
i = 1
while i <= 10:
    sum += i
    i += 1
assert sum == 55

total = 0
for n in [1, 2, 3, 4, 5]:
    total += n
assert total == 15

// nested loops
count = 0
for a in [1, 2, 3]:
    for b in [4, 5]:
        count += 1
assert count == 6

// break and continue
found = 0
for n in [1, 2, 3, 4, 5, 6]:
    if n == 4:
        break
    if n % 2 == 0:
        continue
    found += n
assert found == 4  // 1 + 3

// --------------------------------------------------------------------------
// Functions
// --------------------------------------------------------------------------

def square(n): return n * n
def cube(n): return n * square(n)

assert square(5) == 25
assert cube(3) == 27

// --------------------------------------------------------------------------
// Recursion
// --------------------------------------------------------------------------

def fact(n):
    if n <= 1: return 1
    return n * fact(n - 1)

assert fact(5) == 120
assert fact(10) == 3628800

def fib(n):
    if n < 2: return n
    return fib(n - 1) + fib(n - 2)

assert fib(10) == 55

// --------------------------------------------------------------------------
// Higher-order functions and lambdas
// --------------------------------------------------------------------------

double = (n) => n * 2
assert double(21) == 42

adder = (a, b) => a + b
assert adder(3, 4) == 7

def apply(fn, x):
    return fn(x)

assert apply(double, 5) == 10

def compose(f, g):
    return (x) => f(g(x))

inc = (n) => n + 1
assert compose(double, inc)(10) == 22   // double(11) = 22

// --------------------------------------------------------------------------
// Lists
// --------------------------------------------------------------------------

xs = [1, 2, 3, 4, 5]
assert xs[0] == 1
assert xs[-1] == 5

xs.append(6)
assert len(xs) == 6
assert xs[5] == 6

// iterate
s = 0
for n in xs:
    s += n
assert s == 21

// --------------------------------------------------------------------------
// Dictionaries
// --------------------------------------------------------------------------

m = {"a": 1, "b": 2}
assert m["a"] == 1
assert m["b"] == 2

// --------------------------------------------------------------------------
// Try / except
// --------------------------------------------------------------------------

def safe_div(a, b):
    if b == 0: throw "divide by zero"
    return a / b

caught = false
try:
    safe_div(10, 0)
except as err:
    caught = true
assert caught

assert safe_div(10, 2) == 5

// --------------------------------------------------------------------------
// String operations
// --------------------------------------------------------------------------

s = "hello"
assert s[0] == "h"
assert s[-1] == "o"
assert s + " " + "world" == "hello world"

// --------------------------------------------------------------------------
// print (side-effect smoke test)
// --------------------------------------------------------------------------

print("vm_semantics.jpy — all assertions passed")
