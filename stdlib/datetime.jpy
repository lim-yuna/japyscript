// JapyScript standard library — datetime module

class DateTime:
    def __init__(self, year, month, day, hour, minute, second, nanos):
        self.year   = year
        self.month  = month
        self.day    = day
        self.hour   = hour
        self.minute = minute
        self.second = second
        self.nanos  = nanos

    def iso(self):
        return pad4(self.year) + "-" + pad2(self.month) + "-" + pad2(self.day) + "T" + pad2(self.hour) + ":" + pad2(self.minute) + ":" + pad2(self.second) + "Z"

    def date(self):
        return pad4(self.year) + "-" + pad2(self.month) + "-" + pad2(self.day)

    def time(self):
        return pad2(self.hour) + ":" + pad2(self.minute) + ":" + pad2(self.second)

def pad2(n):
    if n < 10: return "0" + str(n)
    return str(n)

def pad4(n):
    s = str(n)
    while len(s) < 4:
        s = "0" + s
    return s

def now():
    return _now_utc()

def from_unix(seconds):
    return _unix_to_datetime(seconds)

def to_unix(dt):
    return _datetime_to_unix(dt)

def parse_iso(s):
    return _parse_iso(s)

def add_seconds(dt, n):
    return from_unix(to_unix(dt) + n)

def add_minutes(dt, n):
    return add_seconds(dt, n * 60)

def add_hours(dt, n):
    return add_seconds(dt, n * 3600)

def add_days(dt, n):
    return add_seconds(dt, n * 86400)

def diff_seconds(a, b):
    return to_unix(a) - to_unix(b)

def is_leap_year(year):
    if year % 400 == 0: return true
    if year % 100 == 0: return false
    return year % 4 == 0

def days_in_month(year, month):
    if month == 2:
        if is_leap_year(year): return 29
        return 28
    if month in [4, 6, 9, 11]: return 30
    return 31
